name: Generate Stats Images
on:
  schedule:
    - cron: "0 0 * * *"   
  workflow_dispatch:       
jobs:
  generate:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        
      - name: Generate GitHub Stats
        uses: anuraghazra/github-readme-stats-action@v2
        with:
          username: victor-hugo-de-alencar-morais
          show_icons: true
          theme: dark
          include_all_commits: true
          count_private: true
          output_path: .github/stats/stats.svg

      - name: Generate Top Languages
        uses: anuraghazra/github-readme-stats-action@v2
        with:
          username: victor-hugo-de-alencar-morais
          layout: compact
          langs_count: 16
          theme: dark
          output_path: .github/stats/langs.svg
          api: top-langs
          
      - name: Commit generated SVGs
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email 'github-actions[bot]@users.noreply.github.com'
          git add .github/stats/
          git diff --staged --quiet || git commit -m "Update stats images"
          git push
